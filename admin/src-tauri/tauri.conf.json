{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aruaru-DB Admin",
  "version": "0.4.0",
  "identifier": "tokyo.aon.aruaru-db.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aruaru-DB Admin",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
